{
  "name": "dsh-plugin-taskbar-autohide",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 插件：DSH 窗口在前台时隐藏 Windows 任务栏，失焦时恢复。事件驱动（SetWinEventHook）+ 宿主守护（崩溃/假死自动重启），随 DSH 生命周期起停；附带 F11 真全屏。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "taskbar",
    "fullscreen",
    "windows"
  ],
  "license": "MIT"
}
